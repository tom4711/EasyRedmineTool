<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EasyRedmineTool.Core.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="EasyRedmineTool.Desktop.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                HorizontalAlignment="Stretch">
    <Grid Margin="24"
          Width="{Binding $parent[ScrollViewer].Viewport.Width}"
          HorizontalAlignment="Left">
      <Border Width="{Binding $parent[Grid].Bounds.Width}"
            MaxWidth="640"
            HorizontalAlignment="Left">
      <StackPanel Spacing="12">
        <TextBlock Text="Einstellungen" FontSize="22" FontWeight="Bold" />

        <TextBlock Text="Basis-URL" />
        <TextBox Text="{Binding BaseUrl}" PlaceholderText="https://redmine.example.com/" />

        <TextBlock Text="API-Schlüssel" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Grid.Column="0"
                   Text="{Binding ApiKey}"
                   PasswordChar="{Binding ApiKeyPasswordChar}" />
          <Button Grid.Column="1"
                  Classes="secondary"
                  Command="{Binding ToggleApiKeyVisibilityCommand}"
                  Content="{Binding ApiKeyVisibilityActionLabel}" />
        </Grid>
        <TextBlock Text="{Binding ApiKeyStorageWarning}"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Opacity="0.75" />
        <Expander Header="Speicherort anzeigen">
          <TextBlock Text="{Binding ApiKeyStoragePath}"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Margin="0,8,0,0" />
        </Expander>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary"
                  Command="{Binding SaveSettingsCommand}"
                  Content="{materialIcons:MaterialIconTextExt Kind=ContentSave, Text=Speichern}" />
          <Button Classes="secondary"
                  Command="{Binding TestConnectionCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Content="{materialIcons:MaterialIconTextExt Kind=LinkVariant, Text=Verbindung testen}" />
        </StackPanel>

        <TextBlock Text="{Binding SaveStatusMessage}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ConnectionStatusMessage}" TextWrapping="Wrap" />
      </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
