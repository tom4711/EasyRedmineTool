<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EasyRedmineTool.Core.ViewModels"
    xmlns:tickets="using:EasyRedmineTool.Core.Models.Tickets"
    xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Class="EasyRedmineTool.Desktop.Views.KanbanDashboardView"
    x:DataType="vm:KanbanDashboardViewModel">
  <UserControl.Styles>
    <Style Selector="Border.dashboard-surface">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.kanban-column">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.kanban-ticket">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="24,24,24,12" Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="Teamboard" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Projektübergreifender Überblick über den aktuellen Ticketstatus." Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
            <TextBlock Text="Aktualisieren" />
          </StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.8" />

      <Expander Header="Teamboard konfigurieren · Projekte und einzelne Tickets auswählen">
        <Border Classes="dashboard-surface" Padding="14" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Projekte" FontWeight="SemiBold" />
              <TextBlock Text="Die Projekte werden separat geladen. Beim Auswählen werden nur Tickets dieses Projekts abgerufen." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
              <TextBlock Text="Projektliste filtern" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding ProjectFilterFields}"
                          SelectedItem="{Binding SelectedProjectFilterField, Mode=TwoWay}"
                          PlaceholderText="Projektangabe" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProjectFilterValues}"
                          SelectedItem="{Binding SelectedProjectFilterValue, Mode=TwoWay}"
                          PlaceholderText="Wert" />
                <Button Grid.Column="2" Classes="secondary" Command="{Binding ClearProjectFilterCommand}" Content="Zurücksetzen" />
              </Grid>
              <TextBlock Text="{Binding Projects.Count, StringFormat='Angezeigt: {0}'}" FontSize="12" Opacity="0.7" />
              <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Einzelne Tickets zusätzlich" FontWeight="SemiBold" />
              <TextBlock Text="Tickets projektunabhängig über ihre Nummer hinzufügen." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding TicketIdToAdd}" PlaceholderText="Ticketnummer" />
                <Button Grid.Column="1" Classes="secondary" Command="{Binding AddTicketByIdCommand}" IsEnabled="{Binding !IsBusy}" Content="Hinzufügen" />
              </Grid>
              <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding AdditionalTickets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardTicketChoice">
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Ticket.Subject}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Ticket.Id, StringFormat=#\{0\}}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Grid>
        </Border>
      </Expander>
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Columns}" Margin="24,0,24,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KanbanColumn">
            <Border Classes="kanban-column" Width="270" Height="520" Padding="12">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="dashboard-surface" Padding="6,1" CornerRadius="9">
                    <TextBlock Text="{Binding Count}" FontSize="11" />
                  </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="0">
                    <ItemsControl ItemsSource="{Binding Tickets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tickets:IssueDto">
                          <Border Classes="kanban-ticket" Padding="10" Margin="0,0,0,8" DoubleTapped="OnTicketDoubleTapped">
                            <StackPanel Spacing="6">
                              <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Project.Name}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Assigned_To.Name}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Due_Date, StringFormat=Fällig: {0}}" FontSize="11" Opacity="0.7" />
                              </Grid>
                              <TextBlock Text="{Binding Tracker.Name}" FontSize="10" Opacity="0.65" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Keine Tickets" IsVisible="{Binding !HasTickets}" Opacity="0.65" FontSize="12" />
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
